{
  "name": "@floorplan/root",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "bun --cwd services/api run dev",
    "dev:web": "bun --cwd apps/web run dev",
    "test": "bun --cwd packages/shared test && bun --cwd services/api test",
    "lint": "bunx eslint .",
    "fmt": "bunx prettier -w .",
    "docs:lint": "bunx markdownlint-cli2 '**/*.md'",
    "ios:gen": "cd apps/ios && bunx xcodegen generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "bun --cwd services/api run db:migrate"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "eslint": "9.39.2",
    "markdownlint-cli2": "0.20.0",
    "prettier": "3.8.1"
  }
}
